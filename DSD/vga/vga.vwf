<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="C:/Users/jespe/OneDrive - Aarhus Universitet/E2DSD/DSD_exercises_code/Exercise8/VGA/VGA/simulation/qsim/" vga -c vga</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work vga.vho
vcom -work work vga.vwf.vht
